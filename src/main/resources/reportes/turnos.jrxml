            <staticText>
                <reportElement x="145" y="0" width="110" height="18" mode="Opaque" backcolor="#F6F6F4"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true" pdfEncoding="Identity-H" isPdfEmbedded="true"/></textElement>
                <text><![CDATA[Obra social]]></text>
            </staticText>
            <staticText>
                <reportElement x="255" y="0" width="70" height="18" mode="Opaque" backcolor="#F6F6F4"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true" pdfEncoding="Identity-H" isPdfEmbedded="true"/></textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="325" y="0" width="60" height="18" mode="Opaque" backcolor="#F6F6F4"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true" pdfEncoding="Identity-H" isPdfEmbedded="true"/></textElement>
                <text><![CDATA[Hora]]></text>
            </staticText>
            <staticText>
                <reportElement x="385" y="0" width="130" height="18" mode="Opaque" backcolor="#F6F6F4"/>
                <textElement><font fontName="DejaVu Sans" size="9" isBold="true" pdfEncoding="Identity-H" isPdfEmbedded="true"/></textElement>
                <text><![CDATA[Profesional]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="18">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="0" y="0" width="145" height="16"/>
                <textElement><font fontName="DejaVu Sans" size="9" pdfEncoding="Identity-H" isPdfEmbedded="true"/></textElement>
                <textFieldExpression><![CDATA[$F{paciente}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="145" y="0" width="110" height="16"/>
