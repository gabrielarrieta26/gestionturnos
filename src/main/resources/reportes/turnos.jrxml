<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="turnos" pageWidth="595" pageHeight="842" orientation="Portrait"
              columnWidth="515" leftMargin="40" rightMargin="40" topMargin="36" bottomMargin="36"
              whenNoDataType="NoDataSection">
    <parameter name="DESDE" class="java.lang.String"/>
    <parameter name="HASTA" class="java.lang.String"/>
    <field name="paciente" class="java.lang.String"/>
    <field name="obraSocial" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="hora" class="java.lang.String"/>
    <field name="profesional" class="java.lang.String"/>
    <title>
        <band height="58">
            <staticText>
                <reportElement x="0" y="0" width="515" height="24"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="16" isBold="true" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Informe de turnos]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="28" width="515" height="18"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="11" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Del " + $P{DESDE} + " al " + $P{HASTA}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement x="0" y="0" width="145" height="18" mode="Opaque" backcolor="#F6F6F4"/>
