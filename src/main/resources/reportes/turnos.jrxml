    </detail>
    <noData>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="515" height="24"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="16" isBold="true" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Informe de turnos]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="28" width="515" height="18"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="11" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Del " + $P{DESDE} + " al " + $P{HASTA}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="54" width="515" height="18"/>
